{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "api": {
      "root": "backend/",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "crons": [
    {
      "path": "/api/internal/cron/billing-daily",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/cron/lesson-note-reminders",
      "schedule": "0 17 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
