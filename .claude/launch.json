{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "platform-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "platform/web",
        "run",
        "dev"
      ],
      "port": 3100,
      "autoPort": false
    }
  ]
}
