# Abdera - production reverse proxy.
#
# Tek domain altında hem API hem arayüz yayınlanır. Bu bilinçli bir tercih: aynı origin
# olduğu için oturum çerezi üçüncü-taraf cookie kısıtlarına takılmaz ve CORS pratikte
# devre dışı kalır (Frontend__Origin yine de aynı domain'e ayarlanır).
#
# Caddy sertifikayı Let's Encrypt'ten kendisi alır ve yeniler - ayrı bir certbot/cron
# kurulumu yoktur. 80 ve 443 portlarının dışarıdan erişilebilir olması ve PUBLIC_DOMAIN'in
# bu sunucuya çözülmesi yeterlidir.
#
# Kullanım: docker compose --profile prod up -d
# (profil olmadan geliştirme akışı bugünkü gibi 3000/8080 üzerinden çalışmaya devam eder)
{
	email {$ACME_EMAIL}
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# API ve sağlık kontrolü backend'e. handle_path DEĞİL handle: /api ön eki
	# backend'in route tanımlarının bir parçası, soyulmamalı.
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health {
		reverse_proxy api:8080
	}

	# Geri kalan her şey Next.js'e.
	handle {
		reverse_proxy web:3000
	}

	# Tarayıcı tarafı sertleştirme. Caddy otomatik HTTPS ve HTTP->HTTPS yönlendirmesi
	# sağlar, ancak HSTS başlığını kendiliğinden eklemez; bunu açıkça gönderiyoruz.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; upgrade-insecure-requests"
		-Server
	}
}

# Okulun herkese açık tanıtım sayfası (site/ klasörü, düz dosya). Panelden bağımsız:
# api/web kapalıyken de açılır. Meta'nın WhatsApp işletme kontrolü okula ait, adı ve
# iletişim bilgisi görünen gerçek bir site istiyor.
#
# SITE_DOMAIN sunucudaki .env'den gelir (örn. okulum.com). Varsayılan site.localhost:
# değişken tanımsızken Caddy boş adresle düşmesin ve gerçek bir alan adı için sertifika
# istemesin (localhost adlarına kendi iç sertifikasını verir).
{$SITE_DOMAIN:site.localhost} {
	encode zstd gzip
	root * /srv/site
	file_server

	@assets path /fonts/* *.webp *.png *.css
	header @assets Cache-Control "public, max-age=86400"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; style-src 'self'; img-src 'self'; font-src 'self'"
		-Server
	}
}

www.{$SITE_DOMAIN:site.localhost} {
	redir https://{$SITE_DOMAIN:site.localhost}{uri} permanent
}
