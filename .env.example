# ==========================================================================
# Abdera - ornek ortam degiskenleri
#
# Bu dosya SABLONDUR. Gercek deger ICERMEZ ve iceremez - repo public'tir.
# Kullanim:  cp .env.example .env   ve .env icini doldur. .env commit'lenmez.
# ==========================================================================

# --- Okul kimligi ---
SCHOOL_NAME=Abdera Muzik Okulu
SCHOOL_TIMEZONE=Europe/Istanbul
SCHOOL_CURRENCY=TRY
SCHOOL_LOCALE=tr-TR

# --- Veritabani ---
# POSTGRES_HOST=db, docker-compose.yml'in kendi ic agindaki servis adidir; compose
# ConnectionStrings__Default'u bu degerlerden KENDISI uretir (bkz. docker-compose.yml
# api servisi) - asagidaki POSTGRES_* satirlari yeterli, ConnectionStrings__Default'u
# burada ELLE YAZMANA gerek yok. `.env` dosyasi icinde ${DEGISKEN} SEKLINDE INTERPOLASYON
# YAPILMAZ (yalnizca docker-compose.yml'in kendisi bunu yapar) - o yuzden burada literal
# bir ConnectionStrings__Default vermiyoruz, yanlis anlasilip oldugu gibi kullanilabilir.
POSTGRES_DB=abdera
POSTGRES_USER=abdera
POSTGRES_PASSWORD=<GUCLU-PAROLA-URET>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend'i Docker DISINDA (dotnet run ile) calistiriyorsan, container'daki "db" adi
# senin makinenden cozulmez - bu satirin yorumunu kaldirip localhost kullan:
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=abdera;Username=abdera;Password=<POSTGRES_PASSWORD-ile-ayni>

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
# Uygulama ayaga kalkarken bekleyen migration'lari otomatik uygular (docs/08-migrations.md).
# Canlida migration zamanlamasini elle yonetmek istersen false yap.
Database__AutoMigrate=true
# Oturum cerezini imzalayan Data Protection anahtarlarinin yazildigi kalici dizin.
# Bos birakilirsa anahtarlar yalnizca bellekte tutulur - HER container restart/deploy'da
# tum oturumlar sessizce gecersiz kalir (docker-compose bunu kalici bir volume'e baglar).
Auth__KeysDirectory=/app/keys
Auth__CookieName=abdera_session
Auth__SessionHours=12
# Ilk yonetici, yalnizca bos veritabaninda olusturulur
Bootstrap__AdminEmail=admin@example.com
Bootstrap__AdminPassword=<ILK-GIRISTE-DEGISTIR>

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- WhatsApp (Meta Cloud API) ---
# Fake  = mesaj DB'ye yazilir + loglanir, Meta hesabi gerekmez (dev varsayilani)
# Cloud = gercek Meta WhatsApp Cloud API
WhatsApp__Provider=Fake
WhatsApp__PhoneNumberId=<META-PHONE-NUMBER-ID>
WhatsApp__BusinessAccountId=<META-WABA-ID>
WhatsApp__AccessToken=<META-KALICI-TOKEN>
WhatsApp__ApiVersion=v21.0
# Meta webhook dogrulamasi icin rastgele deger
WhatsApp__WebhookVerifyToken=<URET>
# X-Hub-Signature-256 dogrulamasi icin Meta uygulama gizli anahtari
WhatsApp__AppSecret=<META-APP-SECRET>
# RSVP buton payload'larini imzalayan anahtar - tahmin edilebilir id sizdirmamak icin
WhatsApp__PayloadSigningKey=<URET>

# --- Bildirim davranisi ---
# Sessiz saat: bu pencere disindaki is bir sonraki pencerenin basina otelenir (A6)
Notifications__QuietHoursStart=21:00
Notifications__QuietHoursEnd=09:00
Notifications__LessonReminderMinutesBefore=60
Notifications__MaxAttempts=5

# --- Is kurallari ---
# Telafi hakki: dersten en az bu kadar once iptal edilirse kredi dogar (A2)
Policy__MakeupNoticeHours=24
Policy__MakeupCreditValidDays=60

# --- Yedekleme (Faz 4, docs/10-decisions.md G) ---
# Fake = yerel bellekte tutulur, hicbir sunucuya baglanmaz (dev varsayilani)
# Sftp = kullanicinin kendi sunucusuna SSH anahtariyla/parolayla yukler
Backup__Provider=Fake
# AES-256 yedekleme sifreleme anahtari - Fake modda bile ZORUNLU (her yedek sifrelenir,
# yalnizca hedef degisir). `openssl rand -base64 32` ile uret, asla commit etme.
Backup__EncryptionKey=<URET: openssl rand -base64 32>
# Backup__Provider=Sftp iken zorunlu:
Backup__Sftp__Host=<SUNUCU-ADRESI>
Backup__Sftp__Port=22
Backup__Sftp__Username=<KULLANICI-ADI>
# Ikisinden yalnizca biri dolu olmali - anahtar tercih edilir
Backup__Sftp__PrivateKeyPath=<ORNEK: /app/keys/backup_id_rsa>
Backup__Sftp__Password=
Backup__Sftp__RemoteDirectory=/backups/abdera
Backup__RetentionDays=30
Backup__DailyRunTimeLocal=03:00
Backup__CheckIntervalMinutes=15

# --- E-posta alarmi (Faz 4) ---
# Fake = loglanir, hicbir e-posta gonderilmez (dev varsayilani)
# Smtp = herhangi bir SMTP saglayicisi - en kolay kurulum Gmail: hesapta 2 Adimli Dogrulama
# acip myaccount.google.com/apppasswords'ten bir "Uygulama Sifresi" uret
Email__Provider=Fake
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__Username=<eposta@gmail.com>
Email__Smtp__Password=<UYGULAMA-SIFRESI>
Email__Smtp__FromAddress=<eposta@gmail.com>
Email__Smtp__UseSsl=true

# --- Sistem sagligi (Faz 4) ---
# Sorun oldugunda (DB coktu / yedekleme cok eski/basarisiz) uyari e-postasi gidecek adresler
Ops__AlertRecipients=<admin1@ornek.com,admin2@ornek.com>
Ops__HealthCheckIntervalMinutes=10
Ops__AlertCooldownMinutes=60
Ops__BackupStaleAfterHours=30
Ops__BackupUnhealthyAfterHours=48
