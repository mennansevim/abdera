# Playwright kosum ciktilari (trace/video/screenshot) - repoya girmez
frontend/.playwright-artifacts/
frontend/playwright-report/
frontend/test-results/

# Ajan/arac scratch ciktilari (sunum render'lari, ekran goruntuleri) - kaynak degil
.codex-artifacts/

# Uretilmis tanitim sunumu ve inceleme ciktisi - kaynak degil, repo public ve git
# binary'leri gecmisten silmiyor (bir kez girerse her klonda kalicı olarak tasinir).
# Sunumu paylasmak icin repo yerine Drive/Slack kullan.
*.pptx
*.pptx.inspect.ndjson

# k6 yuk testi ham ciktilari (per-run JSON/txt) - tekrar uretilebilir, kaynak degil.
# Ozet ve bulgular LOADTEST.md'de kalici olarak tutuluyor; script'ler (loadtest/k6/,
# loadtest/verify-concurrent-reschedule.sh) commit'lenir, ham sonuclar commit'lenmez.
loadtest/results/
.vercel
.env*

# Toplu kurulum araci ciktilari - veli sifreleri ve kosu raporlari repoya girmemeli.
tools/bulk-seed/sample-credentials.json
tools/bulk-seed/last-run-report.*

# Nota kitabı PDF'leri yayıncı izniyle yalnızca okul içinde kullanılır; repo herkese açık.
# Dosyalar veritabanında durur (tools/import-score-pdfs.py), buraya asla girmez.
*.pdf
.venv/
