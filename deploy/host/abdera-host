#!/usr/bin/env bash
# abdera-host - okul sunucusu ajanı (docs/multi-tenant/ARCHITECTURE.md §6.1, §16).
#
# Platformun SSH anahtarı authorized_keys'te şu kısıtla bağlıdır:
#   command="/usr/local/bin/abdera-host",restrict ssh-ed25519 AAAA... abdera-platform
# Yani platform bu betik dışında hiçbir şey çalıştıramaz; komut SSH_ORIGINAL_COMMAND'dan okunur.
# Elle de çağrılabilir: abdera-host <komut> [argümanlar] [--op <işlem-id>]
#
# Komutlar:
#   create <slug>                    .env stdin'den (0600); dizin, api.env, edge ağı
#   reconfigure <slug>               yeni .env stdin'den (modül/sır değişikliği); imajlar ve kısaltma
#                                    değişemez (sürüm değişikliği upgrade ile), sonra yeniden başlat
#   pull <slug>                      .env'deki imajları çek
#   up <slug> | down <slug>          başlat / durdur (veri kalır)
#   upgrade <slug> <api-ref> <web-ref>  önce döküm, yeni imaj, sağlık; olmazsa eski imaja dön
#   rollback <slug>                  son upgrade'den önceki imajlara dön
#   route add <slug> <domain>        Caddy site bloğu (sunucu kilidi + validate + atomik)
#   route remove <slug>
#   suspend <slug> | resume <slug>   askı: önce son yedek (saklama kuralı dışı), sonra askı sayfası
#   provision <slug>                 kurulum isteği (JSON) stdin'den; okulun iç ağından /api/instance/provision
#   backup-now <slug>                uygulamanın yedeğini tetikle
#   dump <slug>                      uygulamadan bağımsız şifreli döküm (+R2 suspended/ öneki)
#   restore <slug> <döküm> [--drill] dökümden geri yükle; --drill: dış bağlantılar kapalı prova
#   destroy <slug>                   1. aşama: durdur, 30 gün bekleme (ajan zorlar, §16.9)
#   undestroy <slug>                 bekleyen silmeyi geri al
#   purge <slug>                     2. aşama: yalnızca 30 gün dolduysa kalıcı sil. Kurulumu hiç
#                                    tamamlanmamış (verisi olmayan) okul beklemeden silinebilir.
#   status <slug> | host-info | version
#
# --op <id>: platformun işlem kimliği. Aynı id ile tekrar çağrılırsa komut yeniden çalışmaz,
# ilk sonucun kaydı döner (bağlantı koparsa platform güvenle yeniden dener, §16.2).
set -euo pipefail

readonly AGENT_VERSION="1"
ROOT="${ABDERA_ROOT:-/srv/abdera}"
SHARE="${ABDERA_SHARE:-/usr/local/share/abdera}"
CADDY_CONTAINER="${ABDERA_CADDY_CONTAINER:-abdera-caddy}"
DESTROY_GRACE_DAYS="${ABDERA_DESTROY_GRACE_DAYS:-30}"
HEALTH_ATTEMPTS="${ABDERA_HEALTH_ATTEMPTS:-36}"
HEALTH_SLEEP="${ABDERA_HEALTH_SLEEP:-5}"

die() { local code="$1"; shift; echo "HATA: $*" >&2; exit "$code"; }
log() { echo "[$(date -u +%FT%TZ)] $*" >&2; }

# --- Girdi doğrulama: her argüman beyaz listeyle (komut enjeksiyonu yok) ---
valid_slug() { [[ "$1" =~ ^[a-z][a-z0-9-]{2,30}$ ]] && [[ "$1" != *- ]] && [[ "$1" != *--* ]]; }
valid_domain() { [[ "${#1}" -le 253 && "$1" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]]; }
valid_image() { [[ "$1" =~ ^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$ ]]; }
valid_op() { [[ "$1" =~ ^[A-Za-z0-9-]{8,64}$ ]]; }
valid_dump_name() { [[ "$1" =~ ^[A-Za-z0-9._-]{1,120}\.sql\.gz(\.enc)?$ ]]; }

require_slug() { valid_slug "${1:-}" || die 2 "geçersiz okul kısaltması: '${1:-}'"; }
school_dir() { echo "$ROOT/$1"; }
require_school() { [ -f "$(school_dir "$1")/.env" ] || die 4 "okul yok: $1"; }

compose() {
  local slug="$1"; shift
  docker compose -p "abdera-$slug" -f "$(school_dir "$slug")/compose.yml" --env-file "$(school_dir "$slug")/.env" "$@"
}

env_value() { # .env içinden tek değer (yalnızca KEY=VALUE satırları)
  local file="$1" key="$2"
  grep -E "^${key}=" "$file" | tail -n1 | cut -d= -f2-
}

set_env_value() { # atomik güncelleme
  local file="$1" key="$2" value="$3" tmp
  tmp="$(mktemp "$file.XXXX")"
  grep -vE "^${key}=" "$file" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$file"
}

r2_endpoint() { # R2_ENDPOINT yalnızca yerel test ortamında (yerel S3); boşsa Cloudflare R2
  local endpoint
  endpoint="$(env_value "$1/.env" R2_ENDPOINT || true)"
  echo "${endpoint:-https://$(env_value "$1/.env" R2_ACCOUNT_ID).r2.cloudflarestorage.com}"
}
r2_provider() { local provider; provider="$(env_value "$1/.env" R2_PROVIDER || true)"; echo "${provider:-Cloudflare}"; }

write_api_env() { # R2 anahtarları API konteynerine gitmez
  local dir="$1" tmp
  tmp="$(mktemp "$dir/api.env.XXXX")"
  grep -vE '^R2_' "$dir/.env" > "$tmp" || true
  chmod 600 "$tmp"
  mv -f "$tmp" "$dir/api.env"
}

# --- Kilitler ---
lock_school() { # aynı okulda iki işlem aynı anda koşmaz
  mkdir -p "$ROOT/.locks"
  exec 8>"$ROOT/.locks/$1.lock"
  flock -w 600 8 || die 3 "okul kilidi alınamadı: $1"
}
lock_host_caddy() { # paylaşılan Caddy yapılandırması (§16.2)
  mkdir -p "$ROOT/.locks"
  exec 7>"$ROOT/.locks/caddy.lock"
  flock -w 120 7 || die 3 "Caddy kilidi alınamadı"
}

# --- İşlem kaydı (--op) ---
OP_ID=""
OP_SLUG=""
op_file() { echo "$(school_dir "$OP_SLUG")/ops/$OP_ID.json"; }
op_replay() { # aynı işlem daha önce bittiyse sonucunu yazdır ve çık
  [ -n "$OP_ID" ] && [ -n "$OP_SLUG" ] || return 0
  local file; file="$(op_file)"
  if [ -f "$file" ]; then cat "$file"; exit "$(grep -o '"exit":[0-9]*' "$file" | cut -d: -f2)"; fi
}
op_record() {
  local code="$1"
  [ -n "$OP_ID" ] && [ -n "$OP_SLUG" ] && [ -d "$(school_dir "$OP_SLUG")" ] || return 0
  mkdir -p "$(school_dir "$OP_SLUG")/ops"
  printf '{"op":"%s","command":"%s","exit":%d,"at":"%s"}\n' "$OP_ID" "$COMMAND" "$code" "$(date -u +%FT%TZ)" > "$(op_file)"
  cat "$(op_file)"
}

wait_healthy() {
  local slug="$1"
  for _ in $(seq 1 "$HEALTH_ATTEMPTS"); do
    if compose "$slug" exec -T api wget -q --spider http://localhost:8080/health >/dev/null 2>&1; then return 0; fi
    sleep "$HEALTH_SLEEP"
  done
  return 1
}

# --- Caddy ---
render_site() { # $1 slug, $2 domain, $3 mode (live|suspended)
  local slug="$1" domain="$2" mode="$3"
  if [ "$mode" = "live" ]; then
    cat <<EOF
# abdera-host tarafından yazıldı - elle düzenleme.
$domain {
	import abdera_headers
	handle /api/* {
		reverse_proxy $slug-api:8080
	}
	handle /health {
		reverse_proxy $slug-api:8080
	}
	handle {
		reverse_proxy $slug-web:3000
	}
}
EOF
  else
    cat <<EOF
# abdera-host tarafından yazıldı - okul askıda.
$domain {
	import abdera_headers
	root * /etc/caddy/suspended
	rewrite * /index.html
	file_server {
		status 503
	}
}
EOF
  fi
}

caddy_apply() { # $1 slug, $2 içerik ("" = kaldır). Doğrulanmadan yayına girmez.
  local slug="$1" content="$2" staging
  lock_host_caddy
  staging="$(mktemp -d "$ROOT/caddy/.staging.XXXX")"
  mkdir -p "$staging/sites"
  cp "$ROOT/caddy/Caddyfile" "$staging/Caddyfile"
  cp -r "$ROOT/caddy/suspended" "$staging/suspended"
  find "$ROOT/caddy/sites" -maxdepth 1 -name '*.caddy' ! -name "$slug.caddy" -exec cp {} "$staging/sites/" \;
  [ -n "$content" ] && printf '%s\n' "$content" > "$staging/sites/$slug.caddy"
  # Konteyner /etc/caddy'yi $ROOT/caddy'den bağlar; staging aynı ağacın altında.
  if ! docker exec "$CADDY_CONTAINER" caddy validate --adapter caddyfile \
      --config "/etc/caddy/$(basename "$staging")/Caddyfile" >/dev/null 2>&1; then
    rm -rf "$staging"
    die 5 "Caddy yapılandırması doğrulanamadı; yayındaki yapılandırma değişmedi"
  fi
  rm -rf "$staging"
  if [ -n "$content" ]; then
    printf '%s\n' "$content" > "$ROOT/caddy/sites/.$slug.caddy.new"
    mv -f "$ROOT/caddy/sites/.$slug.caddy.new" "$ROOT/caddy/sites/$slug.caddy"
  else
    rm -f "$ROOT/caddy/sites/$slug.caddy"
  fi
  docker exec "$CADDY_CONTAINER" caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null
}

# --- Komutlar ---
cmd_create() {
  local slug="$1" dir
  dir="$(school_dir "$slug")"
  if [ -f "$dir/.env" ]; then
    # İdempotent: aynı içerik yeniden gelirse değişiklik yok; farklıysa reddet (yanlışlıkla ezme yok).
    local incoming; incoming="$(cat)"
    if [ "$incoming" = "$(cat "$dir/.env")" ]; then log "zaten var: $slug"; return 0; fi
    die 6 "okul zaten var ve .env farklı: $slug"
  fi
  mkdir -p "$dir/predeploy" "$dir/dumps" "$dir/ops"
  chmod 700 "$dir"
  umask 077
  cat > "$dir/.env.new"
  [ -s "$dir/.env.new" ] || { rm -f "$dir/.env.new"; die 2 ".env boş"; }
  [ "$(env_value "$dir/.env.new" INSTANCE_SLUG)" = "$slug" ] || { rm -f "$dir/.env.new"; die 2 ".env INSTANCE_SLUG '$slug' değil"; }
  for key in ABDERA_API_IMAGE ABDERA_WEB_IMAGE; do
    valid_image "$(env_value "$dir/.env.new" "$key")" || { rm -f "$dir/.env.new"; die 2 "$key digest'li bir imaj olmalı"; }
  done
  mv -f "$dir/.env.new" "$dir/.env"
  cp "$SHARE/compose.yml" "$dir/compose.yml"
  write_api_env "$dir"
  docker network inspect "abdera-edge-$slug" >/dev/null 2>&1 || docker network create "abdera-edge-$slug" >/dev/null
  docker network connect "abdera-edge-$slug" "$CADDY_CONTAINER" >/dev/null 2>&1 || true
  log "oluşturuldu: $slug"
}

cmd_reconfigure() {
  local slug="$1" dir key
  dir="$(school_dir "$slug")"
  umask 077
  cat > "$dir/.env.new"
  [ -s "$dir/.env.new" ] || { rm -f "$dir/.env.new"; die 2 ".env boş"; }
  # Sürüm ve kimlik bu yoldan değişmez: imaj değişikliği döküm + geri dönüş içeren upgrade'dedir.
  for key in INSTANCE_SLUG ABDERA_API_IMAGE ABDERA_WEB_IMAGE POSTGRES_PASSWORD; do
    [ "$(env_value "$dir/.env.new" "$key")" = "$(env_value "$dir/.env" "$key")" ] \
      || { rm -f "$dir/.env.new"; die 2 "$key reconfigure ile değiştirilemez"; }
  done
  cp "$dir/.env" "$dir/.env.previous"
  mv -f "$dir/.env.new" "$dir/.env"
  write_api_env "$dir"
  compose "$slug" up -d --remove-orphans
  if ! wait_healthy "$slug"; then
    mv -f "$dir/.env.previous" "$dir/.env"
    write_api_env "$dir"
    compose "$slug" up -d --remove-orphans
    die 7 "yeni yapılandırmayla sağlıksız; önceki yapılandırmaya dönüldü"
  fi
}

cmd_pull() { compose "$1" pull --quiet; }
cmd_up() { compose "$1" up -d --remove-orphans; wait_healthy "$1" || die 7 "sağlık kontrolü geçmedi: $1"; }
cmd_down() { compose "$1" stop; }

predeploy_dump() {
  local slug="$1" dir file
  dir="$(school_dir "$slug")"
  file="$dir/predeploy/$(date -u +%Y%m%d-%H%M%S).sql.gz"
  compose "$slug" exec -T db pg_dump -U abdera abdera | gzip > "$file"
  [ -s "$file" ] || die 8 "döküm alınamadı; güncelleme yapılmadı"
  ls -1t "$dir"/predeploy/*.sql.gz | tail -n +6 | xargs -r rm --
}

cmd_upgrade() {
  local slug="$1" api_ref="$2" web_ref="$3" dir prev_api prev_web
  valid_image "$api_ref" || die 2 "geçersiz api imajı"
  valid_image "$web_ref" || die 2 "geçersiz web imajı"
  dir="$(school_dir "$slug")"
  prev_api="$(env_value "$dir/.env" ABDERA_API_IMAGE)"
  prev_web="$(env_value "$dir/.env" ABDERA_WEB_IMAGE)"
  if [ "$prev_api" = "$api_ref" ] && [ "$prev_web" = "$web_ref" ]; then log "zaten bu sürümde"; return 0; fi
  predeploy_dump "$slug"
  printf 'ABDERA_API_IMAGE=%s\nABDERA_WEB_IMAGE=%s\n' "$prev_api" "$prev_web" > "$dir/.previous-images"
  set_env_value "$dir/.env" ABDERA_API_IMAGE "$api_ref"
  set_env_value "$dir/.env" ABDERA_WEB_IMAGE "$web_ref"
  write_api_env "$dir"
  compose "$slug" pull --quiet
  # Yeni imaj sağlıksızsa compose up'ın kendisi de hata döner (web, api'nin sağlığını bekler); set -e
  # betiği geri dönüşten önce bitirmesin diye ikisi tek koşulda.
  if compose "$slug" up -d --remove-orphans && wait_healthy "$slug"; then log "güncellendi: $slug"; return 0; fi
  log "sağlıksız, önceki imaja dönülüyor: $slug"
  cmd_rollback "$slug"
  die 9 "güncelleme geri alındı (şema geri gelmez; migration'lar yalnızca ekleyici olmalı)"
}

cmd_rollback() {
  local slug="$1" dir
  dir="$(school_dir "$slug")"
  [ -f "$dir/.previous-images" ] || die 4 "dönülecek önceki sürüm yok"
  set_env_value "$dir/.env" ABDERA_API_IMAGE "$(env_value "$dir/.previous-images" ABDERA_API_IMAGE)"
  set_env_value "$dir/.env" ABDERA_WEB_IMAGE "$(env_value "$dir/.previous-images" ABDERA_WEB_IMAGE)"
  write_api_env "$dir"
  compose "$slug" up -d --remove-orphans
  wait_healthy "$slug" || die 7 "geri dönüşten sonra da sağlıksız: $slug"
}

cmd_route_add() {
  local slug="$1" domain="$2"
  valid_domain "$domain" || die 2 "geçersiz alan adı: $domain"
  printf '%s\n' "$domain" > "$(school_dir "$slug")/domain"
  caddy_apply "$slug" "$(render_site "$slug" "$domain" live)"
}

cmd_route_remove() { caddy_apply "$1" ""; }

telemetry_token() { env_value "$(school_dir "$1")/.env" Telemetry__Token; }

# Platformun kurulum isteği (§6 adım 9). Jeton .env'den okunur, komut satırına yazılmaz; istek
# okulun iç ağından gider (henüz DNS/Caddy yokken de çalışır). Başarıda .provisioned işareti yazılır:
# bu işaret varsa okul artık veri taşır ve silme 30 günlük beklemeye tabidir.
cmd_provision() {
  local slug="$1" dir body
  dir="$(school_dir "$slug")"
  # Jeton API konteynerinin kendi ortamındadır (api.env); burada yalnızca var olduğu denetlenir.
  [ -n "$(env_value "$dir/.env" Provisioning__Token)" ] || die 2 "Provisioning__Token yok"
  body="$(head -c 1048576)"
  [ -n "$body" ] || die 2 "kurulum isteği boş"
  printf '%s' "$body" | compose "$slug" exec -T api sh -c \
    'cat > /tmp/provision.json && wget -q -O- --header="Content-Type: application/json" --header="Authorization: Bearer $Provisioning__Token" --post-file=/tmp/provision.json http://localhost:8080/api/instance/provision; code=$?; rm -f /tmp/provision.json; exit $code' \
    || die 11 "okul kurulum isteğini reddetti"
  echo
  touch "$dir/.provisioned"
}

cmd_backup_now() {
  local slug="$1"
  compose "$slug" exec -T api wget -q -O- --post-data='' \
    --header="Authorization: Bearer $(telemetry_token "$slug")" http://localhost:8080/api/instance/backup-now >/dev/null
}

# Uygulamadan bağımsız döküm (§16.3): API durmuş olsa da DB'den alınır, okulun yedek anahtarıyla
# şifrelenir. R2 tanımlıysa saklama kuralının DIŞINDAKİ suspended/ önekine kopyalanır.
cmd_dump() {
  local slug="$1" dir key file
  dir="$(school_dir "$slug")"
  key="$(env_value "$dir/.env" Backup__EncryptionKey)"
  [ -n "$key" ] || die 2 "Backup__EncryptionKey yok"
  file="$dir/dumps/$slug-$(date -u +%Y%m%d-%H%M%S).sql.gz.enc"
  compose "$slug" up -d db >/dev/null
  compose "$slug" exec -T db pg_dump -U abdera abdera | gzip \
    | ABDERA_KEY="$key" openssl enc -aes-256-cbc -pbkdf2 -salt -pass env:ABDERA_KEY > "$file"
  [ -s "$file" ] || die 8 "döküm alınamadı"
  if [ -n "$(env_value "$dir/.env" R2_ACCESS_KEY_ID)" ]; then
    # Anahtarlar komut satırına değil ortama verilir (ps çıktısında görünmesin).
    # ABDERA_DOCKER_RUN_OPTS: yalnızca SELinux'lu yerel test VM'i (label=disable).
    # shellcheck disable=SC2086
    RCLONE_CONFIG_R2_ACCESS_KEY_ID="$(env_value "$dir/.env" R2_ACCESS_KEY_ID)" \
    RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$(env_value "$dir/.env" R2_SECRET_ACCESS_KEY)" \
    RCLONE_CONFIG_R2_ENDPOINT="$(r2_endpoint "$dir")" \
    docker run --rm ${ABDERA_DOCKER_RUN_OPTS:-} -v "$dir/dumps:/dumps:ro" \
      -e RCLONE_CONFIG_R2_ACCESS_KEY_ID -e RCLONE_CONFIG_R2_SECRET_ACCESS_KEY -e RCLONE_CONFIG_R2_ENDPOINT \
      -e RCLONE_CONFIG_R2_TYPE=s3 -e RCLONE_CONFIG_R2_PROVIDER="$(r2_provider "$dir")" -e RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true \
      rclone/rclone:1.75.1 copyto "/dumps/$(basename "$file")" "r2:$(env_value "$dir/.env" R2_BUCKET)/$slug/suspended/$(basename "$file")" \
      >/dev/null 2>&1 || log "UYARI: R2 kopyası alınamadı; yerel döküm duruyor: $file"
  fi
  echo "$file"
}

cmd_suspend() {
  local slug="$1" domain
  cmd_dump "$slug" >/dev/null
  domain="$(cat "$(school_dir "$slug")/domain" 2>/dev/null || true)"
  [ -n "$domain" ] && caddy_apply "$slug" "$(render_site "$slug" "$domain" suspended)"
  compose "$slug" stop api web
  touch "$(school_dir "$slug")/.suspended"
}

cmd_resume() {
  local slug="$1" domain
  compose "$slug" up -d --remove-orphans
  wait_healthy "$slug" || die 7 "sağlık kontrolü geçmedi: $slug"
  domain="$(cat "$(school_dir "$slug")/domain" 2>/dev/null || true)"
  [ -n "$domain" ] && caddy_apply "$slug" "$(render_site "$slug" "$domain" live)"
  rm -f "$(school_dir "$slug")/.suspended"
}

# Geri yükleme. --drill: aynı sunucuda ayrı bir prova kopyası (<slug>-drill) dış bağlantılar
# KAPALI kurulur (WhatsApp/e-posta/banka/alarm/yedek), Caddy'ye eklenmez (§16.7).
cmd_restore() {
  local slug="$1" dump="$2" drill="$3" dir target key source
  valid_dump_name "$dump" || die 2 "geçersiz döküm adı"
  dir="$(school_dir "$slug")"
  source="$dir/dumps/$dump"; [ -f "$source" ] || source="$dir/predeploy/$dump"
  [ -f "$source" ] || die 4 "döküm yok: $dump"
  key="$(env_value "$dir/.env" Backup__EncryptionKey)"
  if [ "$drill" = "1" ]; then
    target="$slug-drill"
    valid_slug "$target" || die 2 "prova adı geçersiz"
    # dumps/ ve ops/: prova kopyası da destroy (önce döküm) ve --op kaydıyla silinebilsin.
    mkdir -p "$(school_dir "$target")/dumps" "$(school_dir "$target")/ops"; chmod 700 "$(school_dir "$target")"
    sed -E -e "s/^INSTANCE_SLUG=.*/INSTANCE_SLUG=$target/" \
      -e '/^(WhatsApp__Provider|Email__Provider|Banking__Provider|Backup__Provider|Alerts__WebhookUrl|Ai__Provider|R2_ACCESS_KEY_ID|R2_SECRET_ACCESS_KEY)=/d' \
      "$dir/.env" > "$(school_dir "$target")/.env"
    printf '%s\n' "WhatsApp__Provider=Disabled" "Email__Provider=Disabled" "Banking__Provider=Manual" \
      "Backup__Provider=Disabled" "Alerts__WebhookUrl=" "Ai__Provider=Disabled" >> "$(school_dir "$target")/.env"
    chmod 600 "$(school_dir "$target")/.env"
    cp "$SHARE/compose.yml" "$(school_dir "$target")/compose.yml"
    write_api_env "$(school_dir "$target")"
    docker network inspect "abdera-edge-$target" >/dev/null 2>&1 || docker network create "abdera-edge-$target" >/dev/null
  else
    target="$slug"
    predeploy_dump "$slug"
  fi
  compose "$target" stop api web >/dev/null 2>&1 || true
  compose "$target" up -d db
  for _ in $(seq 1 30); do compose "$target" exec -T db pg_isready -U abdera -d abdera >/dev/null 2>&1 && break; sleep 2; done
  compose "$target" exec -T db psql -U abdera -d postgres -c 'DROP DATABASE IF EXISTS abdera WITH (FORCE)' >/dev/null
  compose "$target" exec -T db psql -U abdera -d postgres -c 'CREATE DATABASE abdera' >/dev/null
  if [[ "$source" == *.enc ]]; then
    ABDERA_KEY="$key" openssl enc -d -aes-256-cbc -pbkdf2 -pass env:ABDERA_KEY < "$source" | gunzip \
      | compose "$target" exec -T db psql -q -U abdera -d abdera >/dev/null
  else
    gunzip < "$source" | compose "$target" exec -T db psql -q -U abdera -d abdera >/dev/null
  fi
  compose "$target" up -d --remove-orphans
  wait_healthy "$target" || die 7 "geri yükleme sonrası sağlıksız: $target"
  log "geri yüklendi: $target <- $dump"
}

cmd_destroy() { # 1. aşama: veri silinmez
  local slug="$1" dir
  dir="$(school_dir "$slug")"
  [ -f "$dir/.pending-destroy" ] && { log "zaten silinmeyi bekliyor"; return 0; }
  cmd_dump "$slug" >/dev/null
  cmd_route_remove "$slug" || true
  compose "$slug" stop
  date -u +%s > "$dir/.pending-destroy"
  log "silinmeyi bekliyor: $slug ($DESTROY_GRACE_DAYS gün sonra purge ile)"
}

cmd_undestroy() {
  local slug="$1" dir domain
  dir="$(school_dir "$slug")"
  [ -f "$dir/.pending-destroy" ] || die 4 "bekleyen silme yok"
  rm -f "$dir/.pending-destroy"
  cmd_up "$slug"
  domain="$(cat "$dir/domain" 2>/dev/null || true)"
  [ -n "$domain" ] && cmd_route_add "$slug" "$domain"
  return 0
}

cmd_purge() { # 2. aşama: süreyi platform değil ajan denetler
  local slug="$1" dir since now
  dir="$(school_dir "$slug")"
  [ -f "$dir/.pending-destroy" ] || die 10 "önce destroy gerekli"
  since="$(cat "$dir/.pending-destroy")"; now="$(date -u +%s)"
  # Kurulumu tamamlanmamış okulda korunacak veri yok: yarıda kalan kurulumun temizliği beklemez.
  [ ! -f "$dir/.provisioned" ] || [ $(( (now - since) / 86400 )) -ge "$DESTROY_GRACE_DAYS" ] \
    || die 10 "bekleme süresi dolmadı ($DESTROY_GRACE_DAYS gün): $(( (now - since) / 86400 )) gün geçti"
  compose "$slug" down --volumes --remove-orphans
  docker network disconnect "abdera-edge-$slug" "$CADDY_CONTAINER" >/dev/null 2>&1 || true
  docker network rm "abdera-edge-$slug" >/dev/null 2>&1 || true
  rm -rf "$dir"
  log "kalıcı olarak silindi: $slug (R2 yedekleri saklama kuralıyla düşer)"
}

cmd_status() {
  local slug="$1" dir state="running"
  dir="$(school_dir "$slug")"
  [ -f "$dir/.suspended" ] && state="suspended"
  [ -f "$dir/.pending-destroy" ] && state="pending-destroy"
  printf '{"slug":"%s","state":"%s","api":"%s","web":"%s","domain":"%s","healthy":%s}\n' \
    "$slug" "$state" "$(env_value "$dir/.env" ABDERA_API_IMAGE)" "$(env_value "$dir/.env" ABDERA_WEB_IMAGE)" \
    "$(cat "$dir/domain" 2>/dev/null || true)" \
    "$(compose "$slug" exec -T api wget -q --spider http://localhost:8080/health >/dev/null 2>&1 && echo true || echo false)"
}

cmd_host_info() {
  local mem_total mem_avail disk_free schools
  mem_total="$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)"
  mem_avail="$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)"
  disk_free="$(df -Pm "$ROOT" 2>/dev/null | awk 'NR==2 {print $4}' || echo 0)"
  schools="$(find "$ROOT" -mindepth 2 -maxdepth 2 -name .env 2>/dev/null | wc -l | tr -d ' ')"
  printf '{"agent":"%s","memTotalMb":%s,"memAvailableMb":%s,"diskFreeMb":%s,"schools":%s}\n' \
    "$AGENT_VERSION" "${mem_total:-0}" "${mem_avail:-0}" "${disk_free:-0}" "${schools:-0}"
}

# --- Giriş noktası ---
if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
  # Kabuk yorumlamadan bölünür: tırnak/değişken/joker genişletmesi yok.
  read -r -a ARGS <<< "$SSH_ORIGINAL_COMMAND"
else
  ARGS=("$@")
fi
[ "${#ARGS[@]}" -gt 0 ] || die 2 "komut yok"

# --op <id> herhangi bir yerde olabilir
FILTERED=()
DRILL=0
i=0
while [ $i -lt ${#ARGS[@]} ]; do
  case "${ARGS[$i]}" in
    --op) OP_ID="${ARGS[$((i+1))]:-}"; valid_op "$OP_ID" || die 2 "geçersiz işlem kimliği"; i=$((i+2)); continue ;;
    --drill) DRILL=1 ;;
    *) FILTERED+=("${ARGS[$i]}") ;;
  esac
  i=$((i+1))
done
set -- "${FILTERED[@]}"
COMMAND="$1"; shift

case "$COMMAND" in
  version) echo "$AGENT_VERSION"; exit 0 ;;
  host-info) cmd_host_info; exit 0 ;;
  route) SUB="${1:-}"; shift || true; COMMAND="route-$SUB" ;;
esac

SLUG="${1:-}"
require_slug "$SLUG"
OP_SLUG="$SLUG"
lock_school "$SLUG"
op_replay

set +e
(
  set -e
  case "$COMMAND" in
    create) cmd_create "$SLUG" ;;
    reconfigure) require_school "$SLUG"; cmd_reconfigure "$SLUG" ;;
    pull) require_school "$SLUG"; cmd_pull "$SLUG" ;;
    up) require_school "$SLUG"; cmd_up "$SLUG" ;;
    down) require_school "$SLUG"; cmd_down "$SLUG" ;;
    upgrade) require_school "$SLUG"; [ $# -eq 3 ] || die 2 "upgrade <slug> <api> <web>"; cmd_upgrade "$SLUG" "$2" "$3" ;;
    rollback) require_school "$SLUG"; cmd_rollback "$SLUG" ;;
    route-add) require_school "$SLUG"; [ $# -eq 2 ] || die 2 "route add <slug> <domain>"; cmd_route_add "$SLUG" "$2" ;;
    route-remove) require_school "$SLUG"; cmd_route_remove "$SLUG" ;;
    suspend) require_school "$SLUG"; cmd_suspend "$SLUG" ;;
    resume) require_school "$SLUG"; cmd_resume "$SLUG" ;;
    provision) require_school "$SLUG"; cmd_provision "$SLUG" ;;
    backup-now) require_school "$SLUG"; cmd_backup_now "$SLUG" ;;
    dump) require_school "$SLUG"; cmd_dump "$SLUG" ;;
    restore) require_school "$SLUG"; [ $# -eq 2 ] || die 2 "restore <slug> <döküm> [--drill]"; cmd_restore "$SLUG" "$2" "$DRILL" ;;
    destroy) require_school "$SLUG"; cmd_destroy "$SLUG" ;;
    undestroy) require_school "$SLUG"; cmd_undestroy "$SLUG" ;;
    purge) require_school "$SLUG"; cmd_purge "$SLUG" ;;
    status) require_school "$SLUG"; cmd_status "$SLUG" ;;
    *) die 2 "bilinmeyen komut: $COMMAND" ;;
  esac
)
CODE=$?
set -e
op_record "$CODE" >/dev/null || true
exit "$CODE"
