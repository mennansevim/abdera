# Abdera okul kurulumu .env şablonu (docs/multi-tenant/ARCHITECTURE.md §5.5, §6 adım 3).
# Platform doldurur ve `abdera-host create <slug>` komutuna stdin'den verir; dosya 0600 yazılır.
# Burada gerçek sır YOK; <...> alanları kurulumda üretilir. Production'da ProductionSecretsGuard
# placeholder ve eksik değerleri reddeder (uygulama açılmaz).

INSTANCE_SLUG=<slug>
ABDERA_API_IMAGE=ghcr.io/<org>/abdera-api@sha256:<digest>
ABDERA_WEB_IMAGE=ghcr.io/<org>/abdera-web@sha256:<digest>
App__Version=<surum>

POSTGRES_PASSWORD=<32+ karakter rastgele>
Frontend__Origin=https://<slug>.abdera.app
SCHOOL_TIMEZONE=Europe/Istanbul

# Modüller: boş = hepsi açık (yalnızca eski kurulum). Platform her zaman açıkça yazar; hiçbir
# opsiyonel modül seçilmediyse "none".
Modules__Enabled=<groups,finance,...|none>

# Platform erişimi (§5.4) - en az 32 karakter.
Provisioning__Token=<tek kullanımlık>
Telemetry__Token=<jeton>
Alerts__WebhookUrl=https://platform.abdera.app/api/alerts
Alerts__WebhookSecret=<jeton>

# Yedek: SFTP -> backup-gw -> R2 (<bucket>/<slug>/)
Backup__Provider=Sftp
Backup__EncryptionKey=<32 bayt base64>
Backup__Sftp__Host=backup-gw
Backup__Sftp__Port=2022
Backup__Sftp__Username=abdera
Backup__Sftp__Password=<BACKUP_GW_PASSWORD ile aynı>
BACKUP_GW_PASSWORD=<rastgele>
R2_BUCKET=abdera-backups
R2_ACCOUNT_ID=<hesap>
R2_ACCESS_KEY_ID=<yalnızca okuma+yazma, SİLME YOK - §16.9>
R2_SECRET_ACCESS_KEY=<anahtar>

# Opsiyonel modül sağlayıcıları (modül kapalıysa gerekmez - ProductionSecretsGuard)
WhatsApp__Provider=Disabled
Email__Provider=Disabled
Banking__Provider=Manual
Ai__Provider=Disabled

# Oturum
Auth__CookieName=abdera_session
Auth__DevLogin__Enabled=false
Demo__Enabled=false
