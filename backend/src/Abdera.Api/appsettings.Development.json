{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Yalnızca Development: giriş hız sınırı üretimde 15 dakikada 5 denemedir (SEC-3) ama
  // yerel geliştirmede tek bir Playwright koşusu bile beş girişi (admin + öğretmen + veli
  // + izolasyon testi) harcıyor - ikinci koşu 429 alıp testleri düşürüyordu. Sınır burada
  // gevşetilir, kaldırılmaz: sonsuz döngüye giren bir istemciyi hâlâ durdurur.
  // Production'da bu dosya hiç okunmaz, varsayılan 5/15dk geçerli kalır.
  "RateLimiting": {
    "LoginPermitLimit": 100,
    "GuardianOtpPermitLimit": 100
  }
}
